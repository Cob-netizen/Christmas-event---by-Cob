return function()
evConns = {}
giftCount = 0
function applyEventLook()
saveLighting()
tw(Lighting, 3, NIGHT)
setAtmo(3, 0.14, 0.6)
local c = Instance.new("ColorCorrectionEffect")
c.Name = "XmEvCC"
c.Parent = Lighting
tw(c, 3, { TintColor = C(215, 235, 255), Saturation = 0.25, Contrast = 0.12 })
local b = Instance.new("BloomEffect")
b.Name = "XmEvBloom"
b.Intensity = 0.7
b.Size = 36
b.Threshold = 0.85
b.Parent = Lighting
end
function removeEventLook()
restoreLighting(2.5)
for _, n in ipairs({ "XmEvCC", "XmEvBloom" }) do
local o = Lighting:FindFirstChild(n)
if o then Debris:AddItem(o, 2.6) end
end
end
function groundY(pos, rootY)
local hit = workspace:Raycast(V(pos.X, rootY + 60, pos.Z), V(0, -200, 0), rayParams)
return hit and hit.Position.Y or rootY - 3
end
function land(m, p)
if not m.Parent then return end
m:PivotTo(CFrame.new(p) * CFrame.Angles(0, rnd(0, 6), 0))
puff(evFolder, p + V(0, 1, 0), GOLD, 14, 0.8)
sfx(SND.ping, 0.3, 1.2 + math.random() * 0.6)
Debris:AddItem(m, 10)
end
function dropGift(p0, p1, T, H, fall)
if giftCount >= CFG.MaxGifts or not evFolder then return end
giftCount += 1
local m = makeGift(evFolder, rnd(1.8, 3.6))
launch(m, p0, p1, T, H, fall, function() land(m, p1) end)
task.delay(T + 10, function() giftCount = math.max(0, giftCount - 1) end)
end
function newWalker(kind, rootPos)
local elf = kind == "elf"
local a, d = math.random() * 2 * PI, rnd(15, 50)
local p = rootPos + V(math.cos(a) * d, 0, math.sin(a) * d)
return {
rig = elf and makeFolk(evFolder, "elf", 0.7, false) or makeSnow(evFolder, 0.9),
elf = elf, pos = p, tgt = nil, wait = rnd(0, 2), yaw = V(0, 0, -1), gy = rootPos.Y - 3, ray = 0,
speed = elf and rnd(6, 9) or rnd(3, 4.5), ph = rnd(0, 6),
}
end
function stepWalker(w, dt, t, rootPos)
local moving = false
if w.wait > 0 then
w.wait -= dt
else
if not w.tgt then
local a, d = math.random() * 2 * PI, rnd(10, 45)
w.tgt = rootPos + V(math.cos(a) * d, 0, math.sin(a) * d)
end
local to = V(w.tgt.X - w.pos.X, 0, w.tgt.Z - w.pos.Z)
if to.Magnitude < 1.2 then
w.tgt = nil
w.wait = rnd(1.5, 4)
else
local dir = to.Unit
w.yaw = w.yaw:Lerp(dir, math.min(1, dt * 6))
if w.yaw.Magnitude < 0.1 then w.yaw = dir end
w.yaw = w.yaw.Unit
w.pos = w.pos + dir * w.speed * dt
moving = true
end
end
if (w.pos - rootPos).Magnitude > 130 then
local a = math.random() * 2 * PI
w.pos = rootPos + V(math.cos(a) * 60, 0, math.sin(a) * 60)
w.tgt = nil
end
w.ray -= dt
if w.ray <= 0 then
w.ray = 0.15
w.gy = groundY(w.pos, rootPos.Y)
end
local hop, roll = 0, 0
if w.elf then
w.rig.walk = moving and 1 or 0
if not moving then
w.rig.armR = 2.6 + math.sin(t * 6 + w.ph) * 0.5
w.rig.armL = 2.6 + math.sin(t * 6 + w.ph + PI) * 0.5
hop = math.abs(math.sin(t * 6 + w.ph)) * 0.7
else
w.rig.armR, w.rig.armL = 0, 0
end
else
roll = moving and math.sin(t * 6 + w.ph) * 0.12 or math.sin(t * 1.5 + w.ph) * 0.04
hop = moving and math.abs(math.sin(t * 6 + w.ph)) * 0.3 or 0
end
local p = V(w.pos.X, w.gy + hop, w.pos.Z)
setRig(w.rig, CFrame.lookAt(p, p + w.yaw) * CFrame.Angles(0, 0, roll), t)
end
function stopEvent(announce)
if not eventOn then return end
eventOn = false
eventToken += 1
for _, c in ipairs(evConns) do c:Disconnect() end
evConns = {}
stopArcs()
removeEventLook()
if evFolder then evFolder:Destroy() evFolder = nil end
if evDrone then evDrone:Destroy() evDrone = nil end
evSky, evSnow, evUnit = nil, nil, nil
if evGui then
if announce then
local l, st = makeLabel("CHRISTMAS EVENT HAS ENDED", 40, GOLD, 10, evGui)
l.Position = UDim2.new(0.5, 0, 0.2, 0)
l.Size = UDim2.new(0.8, 0, 0.06, 0)
st.Color = C(120, 20, 30)
tw(l, 0.5, { TextTransparency = 0 })
tw(st, 0.5, { Transparency = 0.2 })
Debris:AddItem(evGui, 4)
task.delay(3, function() if l.Parent then tw(l, 0.8, { TextTransparency = 1 }) tw(st, 0.8, { Transparency = 1 }) end end)
else
evGui:Destroy()
end
evGui = nil
end
giftCount = 0
end
function startEvent(remaining)
if eventOn then return end
eventOn = true
eventToken += 1
local my = eventToken
local endClock = os.clock() + remaining
local function alive() return eventOn and eventToken == my end
applyEventLook()
giftCount = 0
evFolder = Instance.new("Folder")
evFolder.Name = "ChristmasEvent"
rayParams.FilterDescendantsInstances = { evFolder, plr.Character }
evGui = Instance.new("ScreenGui")
evGui.Name = "ChristmasEventGui"
evGui.ResetOnSpawn = false
evGui.DisplayOrder = 50
evGui.Parent = plr:WaitForChild("PlayerGui")
banner = makeLabel("CHRISTMAS EVENT", 26, GOLD, 10, evGui)
banner.Position = UDim2.new(0.5, 0, 0.055, 0)
banner.Size = UDim2.new(0.4, 0, 0.04, 0)
banner.TextTransparency = 0.05
banner.UIStroke.Transparency = 0.3
banner.UIStroke.Color = C(120, 20, 30)
timerLbl = makeLabel("", 18, WHITE, 10, evGui)
timerLbl.Font = Enum.Font.GothamBold
timerLbl.Position = UDim2.new(0.5, 0, 0.098, 0)
timerLbl.Size = UDim2.new(0.3, 0, 0.03, 0)
timerLbl.TextTransparency = 0.1
timerLbl.UIStroke.Transparency = 0.4
local intro = makeLabel("THE CHRISTMAS EVENT HAS BEGUN", 44, GOLD, 10, evGui)
intro.Position = UDim2.new(0.5, 0, 0.3, 0)
intro.Size = UDim2.new(0.86, 0, 0.07, 0)
intro.UIStroke.Color = C(120, 20, 30)
tw(intro, 0.5, { TextTransparency = 0 })
tw(intro.UIStroke, 0.5, { Transparency = 0.1 })
task.delay(3.5, function() if intro.Parent then tw(intro, 0.8, { TextTransparency = 1 }) tw(intro.UIStroke, 0.8, { Transparency = 1 }) end end)
local root0 = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
local start = root0 and root0.Position or V(0, 5, 0)
evSky = makeSky(evFolder)
evSnow = makeSnowfall(evFolder)
evUnit = makeUnit(evFolder, CFG.SantaScale)
startArcs()
local walkers = {}
for i = 1, CFG.Elves do walkers[#walkers + 1] = newWalker("elf", start) end
for i = 1, CFG.Snowmen do walkers[#walkers + 1] = newWalker("snow", start) end
local t0, center, tick = os.clock(), start, 0
local lastThrow, lastRain = os.clock(), os.clock()
local function step(dt)
local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
if not root then return end
local now = os.clock()
local t = now - t0
center = center:Lerp(root.Position, math.min(1, dt * 1.5))
local a, R = t * 0.33, CFG.OrbitRadius
local pos = center + V(math.cos(a) * R, CFG.OrbitHeight + math.sin(t * 0.7) * 5, math.sin(a) * R)
local dir = V(-math.sin(a), 0.05 * math.cos(t * 0.7), math.cos(a)).Unit
local cf = CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, 0, -0.22)
placeUnit(evUnit, cf, now, false)
tick += 1
evSnow.CFrame = CFrame.new(cam.CFrame.Position + V(0, 28, 0))
if tick % 3 == 0 then skyUpdate(evSky, t, cam.CFrame.Position) end
if now - lastThrow > CFG.ThrowEvery then
lastThrow = now
evUnit.throwT = now
local ang, d = math.random() * 2 * PI, rnd(8, 70)
local tp = root.Position + V(math.cos(ang) * d, 0, math.sin(ang) * d)
local s = CFG.SantaScale
dropGift(cf * V(2 * s, 4.8 * s, 2.5 * s), V(tp.X, groundY(tp, root.Position.Y) + 1.2, tp.Z), 1.7, 10, false)
end

