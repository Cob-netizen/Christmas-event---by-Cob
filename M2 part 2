function buildPath(pts)
local P = { p = {}, c = { 0 } }
local n = #pts
for i = 1, n - 1 do
local p0, p1, p2, p3 = pts[math.max(1, i - 1)], pts[i], pts[i + 1], pts[math.min(n, i + 2)]
for k = 0, 11 do
local u = k / 12
local u2, u3 = u * u, u * u * u
P.p[#P.p + 1] = (p1 * 2 + (p2 - p0) * u + (p0 * 2 - p1 * 5 + p2 * 4 - p3) * u2 + (p1 * 3 - p0 - p2 * 3 + p3) * u3) * 0.5
end
end
P.p[#P.p + 1] = pts[n]
for i = 2, #P.p do P.c[i] = P.c[i - 1] + (P.p[i] - P.p[i - 1]).Magnitude end
P.L = P.c[#P.c]
return P
end
function pathAt(P, s)
s = math.clamp(s, 0, P.L)
local lo, hi = 1, #P.c
while hi - lo > 1 do
local mid = (lo + hi) // 2
if P.c[mid] <= s then lo = mid else hi = mid end
end
local f = (s - P.c[lo]) / math.max(1e-6, P.c[hi] - P.c[lo])
return P.p[lo]:Lerp(P.p[hi], f)
end
function pathDir(P, s)
return (pathAt(P, s + 5) - pathAt(P, s - 5)).Unit
end
