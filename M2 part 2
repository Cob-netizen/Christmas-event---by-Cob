function makeSky(parent)
local S = { seg = {}, stars = Instance.new("Model"), last = V(1e9, 0, 0), tick = 0 }
local cols = { C(60, 255, 150), C(80, 230, 255), C(190, 110, 255) }
for k = 1, 3 do
local R, n = 620 + k * 70, 40
for i = 1, n do
local p = mk(parent, BLOCK, V(2 * PI * R / n * 1.1, 200, 4), CFrame.new(), cols[k], NEON, 0.6)
S.seg[#S.seg + 1] = { p = p, k = k, i = i, n = n, R = R }
end
end
for i = 1, 150 do
local d = V(rnd(-1, 1), rnd(0.08, 1), rnd(-1, 1)).Unit * 1900
local z = rnd(2, 5)
mk(S.stars, BALL, V(z, z, z), CFrame.new(d), i % 5 == 0 and C(255, 235, 170) or C(220, 235, 255), NEON)
end
S.stars.Parent = parent
S.stars.WorldPivot = CFrame.new()
return S
end
function skyUpdate(S, t, c)
for _, g in ipairs(S.seg) do
local ang = g.i / g.n * 2 * PI
local n1 = math.noise(g.i * 0.21 + g.k * 3.1, t * 0.12, g.k + 0.5)
local n2 = math.noise(g.i * 0.33 + 0.4, t * 0.2 + g.k * 5, 1.7)
local h = math.clamp(190 + 220 * n1, 90, 330)
local R = g.R + n2 * 60
local pos = c + V(math.cos(ang) * R, 70 + h * 0.5 + g.k * 14, math.sin(ang) * R)
g.p.Size = V(g.p.Size.X, h, 4)
g.p.CFrame = CFrame.lookAt(pos, c + V(0, pos.Y - c.Y, 0)) * CFrame.Angles(0, 0, n2 * 0.3)
g.p.Transparency = math.clamp(0.5 - n2 * 1.1 - n1 * 0.4, 0.3, 0.96)
end
if (c - S.last).Magnitude > 40 then
S.last = c
S.stars:PivotTo(CFrame.new(c))
end
end
