function makeDeer(parent, s, rudolph)
local rig = { parent = parent, s = s, walk = 1, ph = math.random() * 6 }
local brown, tan = C(140, 90, 50), C(205, 160, 105)
B(rig, BLOCK, V(1.8, 1.8, 3.4), V(0, 3.2, 0), brown)
B(rig, BLOCK, V(0.9, 1.6, 0.9), V(0, 4.2, -1.6), brown)
B(rig, BLOCK, V(1, 1, 1.4), V(0, 5.0, -2.2), brown)
B(rig, BLOCK, V(0.6, 0.6, 0.7), V(0, 4.8, -3.1), tan)
local nose = B(rig, BALL, V(0.5, 0.5, 0.5), V(0, 4.85, -3.5), rudolph and C(255, 30, 30) or C(25, 25, 30), rudolph and NEON or nil)
if rudolph then
local l = Instance.new("PointLight")
l.Color = C(255, 40, 40) l.Range = 22 * s l.Brightness = 3
l.Parent = nose
end
B(rig, BALL, V(0.2, 0.2, 0.2), V(-0.5, 5.2, -2.7), C(10, 10, 10))
B(rig, BALL, V(0.2, 0.2, 0.2), V(0.5, 5.2, -2.7), C(10, 10, 10))
for _, sx in ipairs({ -1, 1 }) do
B(rig, BLOCK, V(0.15, 1.7, 0.15), V(sx * 0.4, 6.1, -2.0), tan)
B(rig, BLOCK, V(0.8, 0.15, 0.15), V(sx * 0.8, 6.4, -2.0), tan)
B(rig, BLOCK, V(0.15, 0.7, 0.15), V(sx * 1.15, 6.7, -2.0), tan)
B(rig, BLOCK, V(0.2, 0.5, 0.3), V(sx * 0.6, 5.5, -1.9), brown)
end
B(rig, BALL, V(0.6, 0.6, 0.6), V(0, 3.9, 1.8), WHITE)
for i, p in ipairs({ { -0.6, -1.2 }, { 0.6, -1.2 }, { -0.6, 1.2 }, { 0.6, 1.2 } }) do
local ph = (i % 2) * PI + (i > 2 and 1.5 or 0)
B(rig, BLOCK, V(0.5, 2.6, 0.5), V(p[1], 1.3, p[2]), brown, nil, V(p[1], 2.6, p[2]), function(t, r) return CFrame.Angles(math.sin(t * 11 + ph + r.ph) * 0.8 * r.walk, 0, 0) end)
end
return rig
end
function makeSleigh(parent, s)
local rig = { parent = parent, s = s }
local dark = C(150, 20, 30)
B(rig, BLOCK, V(4.4, 0.8, 8), V(0, 1.6, 0), RED)
B(rig, BLOCK, V(0.5, 1.4, 8), V(-2.1, 2.5, 0), RED)
B(rig, BLOCK, V(0.5, 1.4, 8), V(2.1, 2.5, 0), RED)
B(rig, BLOCK, V(4.4, 1.6, 0.5), V(0, 2.8, -3.6), RED)
B(rig, BLOCK, V(4.4, 3.2, 0.5), V(0, 3.6, 3.9), RED)
B(rig, BLOCK, V(4.6, 0.3, 0.6), V(0, 5.3, 3.9), GOLD, NEON)
B(rig, BLOCK, V(3.4, 2.0, 2.2), V(0, 3.0, 2.2), dark)
for _, sx in ipairs({ -1.8, 1.8 }) do
B(rig, BLOCK, V(0.35, 0.5, 10), V(sx, 0.5, 0), GOLD, NEON)
B(rig, BLOCK, V(0.3, 1.2, 0.3), V(sx, 1.0, -2.5), GOLD)
B(rig, BLOCK, V(0.3, 1.2, 0.3), V(sx, 1.0, 2.5), GOLD)
B(rig, BLOCK, V(0.35, 1.6, 0.35), V(sx, 1.3, -5.2), GOLD, NEON)
B(rig, BALL, V(0.7, 0.7, 0.7), V(sx, 2.2, -5.2), GOLD, NEON)
end
B(rig, BALL, V(3.2, 3.2, 3.2), V(0, 3.9, 5.5), C(120, 80, 45))
B(rig, BALL, V(1, 1, 1), V(0, 5.6, 5.5), GOLD, NEON)
local gc = { C(60, 120, 230), C(40, 170, 80), C(250, 200, 60) }
for i, p in ipairs({ { -1.1, -1.5 }, { 1.1, -1.5 }, { 0, -2.8 } }) do
B(rig, BLOCK, V(1.4, 1.4, 1.4), V(p[1], 2.7, p[2]), gc[i])
B(rig, BLOCK, V(1.45, 0.25, 1.45), V(p[1], 2.7, p[2]), WHITE)
end
local lamp = B(rig, BALL, V(0.8, 0.8, 0.8), V(0, 3.9, -4), C(255, 230, 150), NEON)
local l = Instance.new("PointLight")
l.Color = C(255, 220, 150) l.Range = 30 * s l.Brightness = 1.5
l.Parent = lamp
for _, p in ipairs({ V(0, 1.6, 5), V(0, 1.6, 9) }) do
local tr = B(rig, BLOCK, V(1, 1, 1), p, WHITE, nil, nil, nil, 1)
sparkle(tr, GOLD, C(255, 120, 120), 25, 0.9 * s, 1.4, 3 * s)
end
for _, x in ipairs({ -2.6, 2.6 }) do B(rig, BLOCK, V(0.15, 0.15, 20), V(x, 3.3, -14), GOLD) end
B(rig, BLOCK, V(0.15, 0.15, 22), V(0, 3.9, -13), GOLD)
return rig
end
function makeUnit(parent, s)
local u = { s = s, sl = makeSleigh(parent, s), santa = makeFolk(parent, "santa", s, true), deer = {}, throwT = -9 }
for i, p in ipairs({ { -2.6, -9 }, { 2.6, -9 }, { -2.6, -16.5 }, { 2.6, -16.5 }, { 0, -24 } }) do
local d = makeDeer(parent, s, i == 5)
d.ph = i * 1.3
u.deer[i] = { rig = d, x = p[1], z = p[2] }
end
return u
end
function throwArm(d)
if d < 0 then return 0 end
if d < 0.15 then return lerp(0, -1.0, d / 0.15) end
if d < 0.45 then return lerp(-1.0, 2.4, (d - 0.15) / 0.3) end
if d < 0.9 then return lerp(2.4, 0, (d - 0.45) / 0.45) end
return 0
end
function placeUnit(u, cf, t, idle)
local s = u.s
local d = os.clock() - u.throwT
u.santa.armR = throwArm(d)
u.santa.armL = idle and 0.3 or 0.15
setRig(u.sl, cf, t)
setRig(u.santa, cf * CFrame.new(0, 2 * s, 3 * s), t)
for i, e in ipairs(u.deer) do
e.rig.walk = idle and 0 or 1
setRig(e.rig, cf * CFrame.new(e.x * s, (idle and 0 or math.sin(t * 5 + i) * 0.5) * s, e.z * s), t)
end
end
GIFTC = { C(220, 40, 50), C(40, 160, 80), C(60, 120, 230), C(250, 200, 60), C(170, 70, 210), C(255, 255, 255) }
function makeGift(parent, size)
local col = GIFTC[math.random(1, 5)]
local rb = GIFTC[math.random(1, 6)]
if rb == col then rb = GOLD end
local m = Instance.new("Model")
local b = mk(m, BLOCK, V(size, size, size), CFrame.new(), col)
mk(m, BLOCK, V(size * 1.04, size * 1.04, size * 0.22), CFrame.new(), rb)
mk(m, BLOCK, V(size * 0.22, size * 1.04, size * 1.04), CFrame.new(), rb)
mk(m, BALL, V(size * 0.35, size * 0.35, size * 0.35), CFrame.new(0, size * 0.55, 0), rb)
m.PrimaryPart = b
sparkle(b, GOLD, WHITE, 10, size * 0.5, 0.9, 2)
m.Parent = parent
return m
end
arcs, arcConn = {}, nil
function launch(m, p0, p1, T, H, fall, onEnd)
arcs[#arcs + 1] = { m = m, p0 = p0, p1 = p1, T = T, H = H, fall = fall, t0 = os.clock(), onEnd = onEnd,
spin = V(rnd(-4, 4), rnd(-4, 4), rnd(-4, 4)) }
end
function startArcs()
if arcConn then return end
arcConn = RunService.Heartbeat:Connect(function()
local now = os.clock()
for i = #arcs, 1, -1 do
local a = arcs[i]
if not a.m.Parent then
table.remove(arcs, i)
else
local u = (now - a.t0) / a.T
if u >= 1 then
table.remove(arcs, i)
if a.onEnd then a.onEnd(a) end
else
local e = a.fall and u * u or u
local k = now - a.t0
a.m:PivotTo(CFrame.new(a.p0:Lerp(a.p1, e) + V(0, 4 * a.H * u * (1 - u), 0)) * CFrame.Angles(k * a.spin.X, k * a.spin.Y, k * a.spin.Z))
end
end
end
end)
end
function stopArcs()
if arcConn then arcConn:Disconnect() arcConn = nil end
arcs = {}
end
function puff(parent, pos, col, n, size)
local p = mk(parent, BLOCK, V(1, 1, 1), CFrame.new(pos), WHITE, nil, 1)
local e = sparkle(p, col, WHITE, 0, size or 1, 1.3, 22)
e:Emit(n)
Debris:AddItem(p, 2)
return p
end
function ringFx(parent, pos, col, d)
local p = mk(parent, BALL, V(1, 1, 1), CFrame.new(pos), col, NEON, 0.2)
tw(p, 0.6, { Size = V(d, d, d), Transparency = 1 })
Debris:AddItem(p, 0.7)
end
  
