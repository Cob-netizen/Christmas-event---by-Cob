BALL, CYL, NEON = Enum.PartType.Ball, Enum.PartType.Cylinder, Enum.Material.Neon
BLOCK = Enum.PartType.Block
function mk(parent, shape, size, cf, color, mat, tr)
local p = Instance.new("Part")
p.Anchored = true
p.CanCollide = false
p.CanTouch = false
p.CanQuery = false
p.CastShadow = false
p.Shape = shape or BLOCK
p.Size = Vector3.new(math.min(size.X, 2040), math.min(size.Y, 2040), math.min(size.Z, 2040))
p.CFrame = cf
p.Color = color
p.Material = mat or Enum.Material.SmoothPlastic
p.Transparency = tr or 0
p.Parent = parent
return p
end
function cyl(parent, base, h, d, color, mat, tr)
return mk(parent, CYL, Vector3.new(h, d, d), CFrame.new(base + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, PI / 2), color, mat, tr)
end
function disc(parent, pos, d, color, mat, tr)
return mk(parent, CYL, Vector3.new(0.4, d, d), CFrame.new(pos) * CFrame.Angles(0, 0, PI / 2), color, mat, tr)
end
LIGHT_PROPS = { "ClockTime", "FogColor", "FogStart", "FogEnd", "Ambient", "OutdoorAmbient", "Brightness", "ExposureCompensation" }
function saveLighting()
if saved then return end
saved = {}
for _, p in ipairs(LIGHT_PROPS) do saved[p] = Lighting[p] end
local a = Lighting:FindFirstChildOfClass("Atmosphere")
if a then
savedAtm = { Color = a.Color, Decay = a.Decay, Density = a.Density, Haze = a.Haze, Glare = a.Glare, Offset = a.Offset }
end
end
function restoreLighting(t)
if not saved then return end
tw(Lighting, t or 2, saved)
local a = Lighting:FindFirstChildOfClass("Atmosphere")
if a then
if createdAtm then
tw(a, t or 2, { Density = 0, Haze = 0 })
Debris:AddItem(a, (t or 2) + 0.2)
createdAtm = false
elseif savedAtm then
tw(a, t or 2, savedAtm)
end
end
saved, savedAtm = nil, nil
end
function shakeCF(t, amp)
if amp <= 0.001 then return CFrame.identity end
return CFrame.new(math.noise(t * 9, 1, 0) * amp, math.noise(t * 9, 2, 0) * amp, 0)
* CFrame.Angles(math.noise(t * 7, 3, 0) * amp * 0.03, math.noise(t * 7, 4, 0) * amp * 0.03, math.noise(t * 5, 5, 0) * amp * 0.05)
end
