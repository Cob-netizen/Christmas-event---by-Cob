function hoho(parent, vol)
for i = 1, 3 do
task.delay((i - 1) * 0.5, function()
local s = sfx(SND.voice, vol or 0.8, 0.56 - i * 0.03, parent)
pcall(function() local rv = Instance.new("ReverbSoundEffect") rv.DecayTime = 2 rv.Wetness = 0.3 rv.Parent = s end)
end)
end
end
function bells(isOn, vol, gap)
task.spawn(function()
while isOn() do
for i = 1, 3 do
sfx(SND.ping, vol, 2.1 + i * 0.12)
task.wait(0.13)
end
task.wait(gap)
end
end)
end
