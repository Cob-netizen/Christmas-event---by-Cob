function runCutscene()
setupCut()
local my = cutId
local O = V(9000, 4000, 0)
local O2 = O + V(0, 0, 1500)
local W = buildVillage(cutFolder, O)
local Rm = buildRoom(cutFolder, O2)
local Sky = makeSky(cutFolder)
local unit = makeUnit(cutFolder, 1)
startArcs()
local padCF = CFrame.lookAt(O + V(0, 0.3, -70), O + V(0, 0.3, -60))
local phase, tPhase, alarm, letterOn, tick = "ext", 0, false, false, 0
local function place(mode)
if mode == "in" then
tw(Lighting, 0.05, INDOOR)
setAtmo(0.05, 0, 0)
else
tw(Lighting, 0.05, NIGHT)
setAtmo(0.05, 0.12, 0.5)
end
end
local paper = Instance.new("Frame")
paper.Position = UDim2.new(0.04, 0, 0.2, 0)
paper.Size = UDim2.new(0.38, 0, 0.34, 0)
paper.BackgroundColor3 = C(250, 240, 215)
paper.BorderSizePixel = 0
paper.Rotation = -2
paper.ZIndex = 6
paper.Visible = false
paper.Parent = gui
local pl = Instance.new("TextLabel")
pl.BackgroundTransparency = 1
pl.Position = UDim2.new(0.05, 0, 0.08, 0)
pl.Size = UDim2.new(0.9, 0, 0.85, 0)
pl.TextColor3 = C(70, 40, 30)
pl.TextXAlignment = Enum.TextXAlignment.Left
pl.TextYAlignment = Enum.TextYAlignment.Top
pl.TextWrapped = true
pl.TextSize = 18
