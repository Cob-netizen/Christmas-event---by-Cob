rayParams.FilterDescendantsInstances = { plr.Character }
frameHook = function(t)
tick += 1
if snowP then snowP.CFrame = CFrame.new(cam.CFrame.Position + V(0, 28, 0)) end
if tick % 3 == 0 then skyUpdate(Sky, t, cam.CFrame.Position) end
for i, b in ipairs(W.bulbs) do b.Transparency = 0.7 * (math.sin(t * 3 + i * 1.3) * 0.5 + 0.5) end
for _, f in ipairs(W.folks) do
if f.elf then f.rig.armR = 2.6 + math.sin(t * 5) * 0.4 end
setRig(f.rig, f.cf, t)
end
local d = os.clock() - tPhase
local hop = 0
if phase == "read" then
Rm.santa.armL, Rm.santa.armR = 1.0, 1.0
hop = math.sin(t * 1.4) * 0.06
elseif phase == "startle" then
hop = d < 0.5 and math.sin(d / 0.5 * PI) * 1.8 or 0
Rm.santa.armL, Rm.santa.armR = 2.8, 2.8
end
local sCF = CFrame.new(O2 + V(0, hop, -2.6))
setRig(Rm.santa, sCF, t)
if phase == "read" then
Rm.letter.Transparency = 0
Rm.letter.CFrame = sCF * CFrame.new(0, 3.5, -2.0) * CFrame.Angles(-0.35, 0, 0)
else
Rm.letter.Transparency = 1
end
if alarm then
Rm.bBall.Color = C(255, 40, 40)
Rm.bLight.Brightness = 2.5 + 2.5 * math.sin(t * 12)
Rm.bBeam.Transparency = 0.35
Rm.bBeam.CFrame = CFrame.new(Rm.beacon) * CFrame.Angles(0, t * 5, 0)
end
Rm.fireLight.Brightness = 2.2 + math.noise(t * 8, 1, 0) * 1.2
for i, f in ipairs(Rm.flames) do f.Size = V(0.5, math.clamp(1.4 + math.noise(t * 9, i, 0) * 1.4, 0.6, 2.2), 0.5) end
if phase ~= "fly" and phase ~= "end" then placeUnit(unit, padCF, t, true) end
end
place("out")
sleep(0.4)
tw(drone, 1, { Volume = 0.3 * CFG.Volume })
tw(cover, 1.5, { BackgroundTransparency = 1 })
